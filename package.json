{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "prepare": "husky",
    "lint:fix": "eslint . --fix --ext .js,.jsx,.ts,.tsx",
    "fallow": "fallow",
    "fallow:dead-code": "fallow dead-code",
    "fallow:audit": "fallow audit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck:functions": "tsc -p tsconfig.functions.json"
  },
  "dependencies": {
    "@netlify/blobs": "^10.4.1",
    "@sentry/node": "^10.71.0",
    "axios": "^1.13.2",
    "i18next": "^25.6.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^16.3.3",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.9.4",
    "react-spinners": "^0.17.0",
    "resend": "^6.5.2",
    "stripe": "^22.6.0",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.36.0",
    "@netlify/functions": "^5.1.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/i18next": "^13.0.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-unused-imports": "^4.2.0",
    "fallow": "^3.19.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.2.4",
    "netlify-cli": "^23.11.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0 --cache --cache-strategy=content"
    ],
    "*.{js,jsx,ts,tsx,css,md,json}": [
      "prettier --write --ignore-unknown --cache"
    ]
  }
}
